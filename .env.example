# =============================================================================
# UniVA Configuration (.env)
# =============================================================================
# Copy this file to .env and fill in your values.
# Variables defined here override defaults in univa/config/config.py and
# univa/config/mcp_tools_config/config.yaml.

# =========================
# Core Agent Models (Planning & Acting)
# =========================
PLAN_MODEL_PROVIDER=openai
PLAN_MODEL_ID=gpt-5
PLAN_MODEL_API_KEY=
PLAN_MODEL_BASE_URL=
PLAN_MODEL_EXTRA_PARAMS={}

ACT_MODEL_PROVIDER=openai
ACT_MODEL_ID=gpt-5
ACT_MODEL_API_KEY=
ACT_MODEL_BASE_URL=
ACT_MODEL_EXTRA_PARAMS={}

# =========================
# System Configuration
# =========================
AUTH_ENABLED=false
ADMIN_ACCESS_CODE=
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS_PER_USER=10

# Optional proxy settings
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890

# =========================
# Media Providers / Runtime
# =========================
MEDIA_DEFAULT_PROVIDER=fal
IMAGE_PROVIDER=fal
VIDEO_PROVIDER=fal
AUDIO_PROVIDER=hyperframes
EDIT_PROVIDER=hyperframes
OUTPUT_ROOT=results
HYPERFRAMES_CMD=npx -y hyperframes

# Fal.ai primary key
FAL_API_KEY=

# Optional fallback providers
WAVESPEED_API_KEY=
LLM_OPENAI_API_KEY=

# Optional local-model paths (only needed for advanced/local pipelines)
VIDEO_EDIT_MODEL_PATH=
VIDEO_UNDERSTAND_MODEL_PATH=
VIDEO_RETRIEVER_MODEL_PATH=
VIDEO_TRACK_SA2VA_PATH=
VIDEO_TRACK_SAM_PATH=

# Optional VACE/local editing runtime
ENABLE_LOCAL_VACE=false
VACE_ROOT=
VACE_PYTHON=
