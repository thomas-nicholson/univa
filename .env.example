# =============================================================================
# UniVA single-service configuration (.env)
# =============================================================================
# Copy this file to .env.local for apps/web and fill in what you need.
# The new single-service path runs the app as a Next.js/TypeScript service.
# Python is optional and no longer required for core chat/access-code/editor core flows.

# =========================
# TypeScript single-service AI copilot
# =========================
OPENAI_API_KEY=
UNIVA_AGENT_MODEL=gpt-4.1-mini
AUTH_ENABLED=false
ADMIN_ACCESS_CODE=

# =========================
# Optional auth/database stack
# Leave blank if you want the simpler single-service mode without auth.
# =========================
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =========================
# Optional media/runtime settings preserved from the fork
# =========================
MEDIA_DEFAULT_PROVIDER=fal
IMAGE_PROVIDER=fal
VIDEO_PROVIDER=fal
AUDIO_PROVIDER=hyperframes
EDIT_PROVIDER=hyperframes
VIDEO_UNDERSTANDING_PROVIDER=gemini
OUTPUT_ROOT=results
HYPERFRAMES_CMD=npx -y hyperframes
GEMINI_API_KEY=
FAL_API_KEY=
WAVESPEED_API_KEY=

# Optional local-model paths
VIDEO_EDIT_MODEL_PATH=
VIDEO_UNDERSTAND_MODEL_PATH=
VIDEO_RETRIEVER_MODEL_PATH=
VIDEO_TRACK_SA2VA_PATH=
VIDEO_TRACK_SAM_PATH=

# Optional local editing runtime
ENABLE_LOCAL_VACE=false
VACE_ROOT=
VACE_PYTHON=
